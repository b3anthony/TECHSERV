# Copia a .env y ajusta. .env NUNCA se sube ni entra en un worktree de un brazo.
MYSQL_DATABASE=techserv
MYSQL_USER=techserv
MYSQL_PASSWORD=techserv_local
MYSQL_ROOT_PASSWORD=techserv_root

# Clave de firma de los JWT. En el prototipo es de juguete; en producción se
# genera con: openssl rand -base64 48
TECHSERV_JWT_SECRETO=clave-de-desarrollo-solo-local-cambiar-en-produccion-0123456789
TECHSERV_JWT_HORAS=12
TECHSERV_TOKEN_ACCION_HORAS=72

# Dónde vive el frontend, para los enlaces de los correos
TECHSERV_URL_PUBLICA=http://localhost:8080
TECHSERV_URL_FRONTEND=http://localhost:5173
