# Finales de línea fijos para que el proyecto funcione igual en Windows y Linux.
# Sin esto, Git en Windows convierte a CRLF y los scripts de shell (mvnw, *.sh)
# dejan de funcionar con errores como "/usr/bin/env: 'bash\r'".
* text=auto eol=lf

# Los scripts de Windows sí necesitan CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binarios: nunca se tocan.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.jar binary
